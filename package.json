{
  "name": "atem-controller",
  "version": "0.1.0",
  "description": "ATEM SuperSource animation + transition sequencer with OSC control, HyperDeck control and web status UI",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "ui:dev": "cd ui && npm run dev -- --port 3001",
    "ui:build": "cd ui && npm run build",
    "build": "npm run ui:build",
    "deploy": "npm run ui:build && ./deploy/deploy.sh",
    "postinstall": "cd ui && npm install --no-audit --no-fund"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "atem-connection": "^3.5.0",
    "express": "^4.19.0",
    "osc": "^2.4.5",
    "ws": "^8.18.0"
  }
}
